# ==============================================================================
# Esporte+ — variáveis de ambiente do backend (copie para .env e ajuste)
# ==============================================================================

# --- Banco de dados -----------------------------------------------------------
# URL SQLAlchemy (driver psycopg 3). Aponta para o Postgres do docker-compose.yml
# Da raiz do repositório.
DATABASE_URL=postgresql+psycopg://esporte:esporte@localhost:5432/esporte_mais

# --- JWT (Decisões D3/I6) -----------------------------------------------------
# Segredo de assinatura dos access tokens. Gere um valor aleatório, ex.:
# Python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-por-um-segredo-aleatorio
JWT_ALGORITHM=HS256
# Access token curto (30 min) + refresh token persistido em banco (7 dias)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Link de redefinição de senha válido por 1 hora
RESET_TOKEN_EXPIRE_MINUTES=60

# --- Bloqueio por força bruta (Decisão I5) ---------------------------
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# --- E-mail (Decisão D4) ------------------------------------------------------
# MAIL_MODE: "console" (loga a mensagem, dev) ou "smtp" (envia de verdade).
# Em dev, o Mailpit do docker-compose recebe SMTP em localhost:1025
# (interface web em http://localhost:8025).
MAIL_MODE=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@esportemais.local
SMTP_TLS=false

# --- Seed do primeiro Gestor (Decisão I3) -----------------------------
# Usado por: python -m scripts.seed_gestor (a partir de backend/)
GESTOR_INICIAL_NOME=Gestor Inicial
GESTOR_INICIAL_CPF=00000000000
GESTOR_INICIAL_EMAIL=gestor@esportemais.local
GESTOR_INICIAL_SENHA=troque-esta-senha

# --- Frontend (links em e-mails de recuperação; CORS futuro) ------------------
FRONTEND_URL=http://localhost:5173

# --- Módulo 2: agendamentos (Decisões D7/D9/I14) ------------------------------
# Fuso horário para slots, "datas a partir de hoje" e prazo de cancelamento
TIMEZONE=America/Sao_Paulo
# Job periódico que marca agendamentos vencidos como "Concluído" (D9)
SCHEDULER_ENABLED=true
CONCLUIR_AGENDAMENTOS_INTERVALO_MINUTOS=5
