# =============================================================================
# Esporte+ — variáveis do backend quando executado FORA do Docker
# (ex.: uvicorn direto na máquina). Copie para backend/.env e ajuste.
# Com `docker compose up` este arquivo não é usado: vale o .env da raiz.
# A lista completa, com descrições, está em app/core/config.py.
# =============================================================================

# --- Banco de dados ---
# URL SQLAlchemy (driver psycopg 3). Aponta para o Postgres do docker-compose.yml.
DATABASE_URL=postgresql+psycopg://esporte:esporte@localhost:5432/esporte_mais

# --- JWT ---
# Mínimo de 32 caracteres. Para gerar:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres-ou-mais
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Validade do link de redefinição de senha
RESET_TOKEN_EXPIRE_MINUTES=60

# --- Bloqueio de login por tentativas ---
LOGIN_MAX_TENTATIVAS=5
LOGIN_BLOQUEIO_MINUTOS=15

# --- E-mail ---
# "console" imprime no log; "smtp" envia de verdade.
# O Mailpit do docker-compose recebe SMTP em localhost:1025 (UI em localhost:8025).
MAIL_MODE=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@esportemais.local
SMTP_TLS=false

# --- Primeiro Gestor (python -m scripts.seed_gestor) ---
GESTOR_INICIAL_NOME=Gestor Inicial
GESTOR_INICIAL_CPF=52998224725
GESTOR_INICIAL_EMAIL=gestor@esportemais.local
GESTOR_INICIAL_SENHA=troque-esta-senha

# --- Frontend (CORS e links dos e-mails) ---
FRONTEND_URL=http://localhost:5173

# --- Documentação da API (/docs, /redoc, /openapi.json) ---
# Em produção use false para não publicar o mapa de rotas.
DOCS_ENABLED=true

# --- Agendamentos ---
TIMEZONE=America/Sao_Paulo
# Jobs periódicos: conclusão de agendamentos vencidos e envio de lembretes
SCHEDULER_ENABLED=true
CONCLUIR_AGENDAMENTOS_INTERVALO_MINUTOS=5
