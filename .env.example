# =============================================================================
# Esporte+ — variáveis lidas pelo docker-compose.yml (ambiente de desenvolvimento)
#
# Copie para ".env" na raiz. Todos os campos têm valores padrão que funcionam
# em desenvolvimento, mas NÃO são seguros para produção: troque JWT_SECRET,
# senhas e GESTOR_INICIAL_* antes de qualquer implantação real.
# =============================================================================

# --- Postgres ---
POSTGRES_USER=esporte
POSTGRES_PASSWORD=esporte
POSTGRES_DB=esporte_mais

# --- JWT ---
# Mínimo de 32 caracteres (a API não inicia com um segredo mais curto).
# Para gerar um segredo aleatório:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-por-um-segredo-aleatorio-em-producao

# --- E-mail ---
# MAIL_MODE=smtp envia para o Mailpit deste compose (caixa de entrada em :8025).
# MAIL_MODE=console apenas imprime os e-mails no log do backend.
MAIL_MODE=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@esportemais.local

# --- Primeiro Gestor (criado automaticamente na subida do backend) ---
GESTOR_INICIAL_NOME=Gestor Inicial
GESTOR_INICIAL_CPF=52998224725
GESTOR_INICIAL_EMAIL=gestor@esportemais.local
GESTOR_INICIAL_SENHA=Admin@2026

# --- Integração frontend/backend ---
# URL que o NAVEGADOR usa para chamar a API.
VITE_API_URL=http://localhost:8000
# URL do frontend: liberada no CORS do backend e usada nos links dos e-mails.
FRONTEND_URL=http://localhost:5173

TIMEZONE=America/Sao_Paulo

# --- pgAdmin (opcional) ---
# Sobe com: docker compose --profile tools up   ->   http://localhost:5050
PGADMIN_EMAIL=admin@esportemais.local
PGADMIN_PASSWORD=admin
