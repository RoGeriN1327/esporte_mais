# =============================================================================
# Esporte+ — variáveis do docker-compose.yml (raiz)
# Copie para .env; todos os campos têm defaults funcionais para desenvolvimento
# (aceitáveis, NÃO seguros para produção). Troque JWT_SECRET e GESTOR_INICIAL_*
# Antes de qualquer implantação real.
# =============================================================================

# --- Postgres ---
POSTGRES_USER=esporte
POSTGRES_PASSWORD=esporte
POSTGRES_DB=esporte_mais

# --- Backend (JWT / e-mail / seed) ---
# Gere um segredo aleatório para produção, por exemplo:
# Python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=troque-por-um-segredo-aleatorio-em-producao

# MAIL_MODE=smtp usa o Mailpit deste compose por padrão (UI em :8025).
# Para desligar envios em dev, use MAIL_MODE=console (loga a mensagem).
MAIL_MODE=smtp
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=no-reply@esportemais.local

# Bootstrap do primeiro Gestor (Decisão I3)
GESTOR_INICIAL_NOME=Gestor Inicial
GESTOR_INICIAL_CPF=00000000000
GESTOR_INICIAL_EMAIL=gestor@esportemais.local
GESTOR_INICIAL_SENHA=Admin@2026

# --- Frontend / integração ---
# URL que o BROWSER usará para chamar a API (embutida no bundle no build).
# Ao acessar o frontend por outro host que não localhost, ajuste aqui.
VITE_API_URL=http://localhost:8000
# URL do frontend usada nos e-mails de recuperação de senha e no CORS do backend.
FRONTEND_URL=http://localhost:5173

TIMEZONE=America/Sao_Paulo

# --- pgAdmin (opcional, perfil "tools") ---
# Sobe com: docker compose --profile tools up
# Acesso: http://localhost:5050
PGADMIN_EMAIL=admin@esportemais.local
PGADMIN_PASSWORD=admin
